{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "output_ground_truth/**",
      "use": "@vercel/static"
    },
    {
      "src": "{app.js,cloud.js,config.js,logic.js,style.css}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
